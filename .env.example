# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file -- it's already in .gitignore.

# --- LLM Provider: Groq (FREE tier, no billing required) -------------------
# Get a free key at https://console.groq.com/keys -- no card required.
GROQ_API_KEY=your_groq_api_key_here

# Model to use for the agent's reasoning engine.
# llama-3.3-70b-versatile is stable, well-documented, and supports full
# tool/function calling, which this project's tool registry depends on.
GROQ_MODEL=llama-3.3-70b-versatile

# --- Vector Database -------------------------------------------------------
# Chroma runs locally with zero setup -- no key needed. This just sets
# where its on-disk data is stored.
CHROMA_PERSIST_DIR=./data/chroma

# --- Agent Behavior Limits (Section 2.2 / 2.3 of the architecture spec) ---
MAX_REPLAN_CYCLES=3
MAX_TOOL_CALLS_PER_RUN=20
RESEARCH_TIME_BUDGET_SECONDS=300

# --- Retry / Backoff (Section A4.3) ----------------------------------------
MAX_RETRY_ATTEMPTS=5
RETRY_INITIAL_DELAY_SECONDS=1

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- SEC EDGAR (Day 5) ------------------------------------------------------
# The SEC requires every request to identify the requester. Put your real
# name and email here before making real EDGAR calls.
SEC_EDGAR_USER_AGENT=Your Name your_email@example.com

# --- Optional: external tool API keys (wired in from Day 5 onward) --------
# Leave blank for now -- Day 2's tools are stubs and don't need these yet.
TAVILY_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
