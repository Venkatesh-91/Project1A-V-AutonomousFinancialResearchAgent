# Copy this file to .env and fill in real values.
# NEVER commit the actual .env file -- it's already in .gitignore.

# --- LLM Provider: Google Gemini (FREE API tier, no billing required) ----
# Get a free key at https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=your_gemini_api_key_here

# Model to use for the agent's reasoning engine.
# gemini-2.0-flash is fast, free-tier friendly, and supports function
# calling, which this project's tool registry depends on.
GEMINI_MODEL=gemini-2.0-flash

# --- Vector Database -------------------------------------------------------
# Chroma runs locally with zero setup -- no key needed. This just sets
# where its on-disk data is stored.
CHROMA_PERSIST_DIR=./data/chroma

# --- Agent Behavior Limits (Section 2.2 / 2.3 of the architecture spec) ---
MAX_REPLAN_CYCLES=3
MAX_TOOL_CALLS_PER_RUN=20
RESEARCH_TIME_BUDGET_SECONDS=300

# --- Retry / Backoff (Section A4.3) ----------------------------------------
MAX_RETRY_ATTEMPTS=5
RETRY_INITIAL_DELAY_SECONDS=1

# --- Logging -----------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs

# --- Optional: external tool API keys (wired in from Day 5 onward) --------
# Leave blank for now -- Day 2's tools are stubs and don't need these yet.
TAVILY_API_KEY=
FMP_API_KEY=
NEWSAPI_KEY=
