{
  "name": "earnings_transcript",
  "description": "Retrieve the full earnings call transcript for a specific company, quarter, and year, including prepared remarks and the analyst Q&A section.",
  "parameters": {
    "type": "object",
    "properties": {
      "ticker": {
        "type": "string",
        "description": "Stock ticker symbol"
      },
      "quarter": {
        "type": "string",
        "enum": ["Q1", "Q2", "Q3", "Q4"],
        "description": "Fiscal quarter"
      },
      "year": {
        "type": "integer",
        "description": "Fiscal year"
      }
    },
    "required": ["ticker", "quarter", "year"]
  }
}
